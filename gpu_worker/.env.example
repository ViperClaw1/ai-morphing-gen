# Application
APP_NAME=AI Morphing GPU Worker
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Model (pre-downloaded in Docker image or HF cache)
MODEL_ID=runwayml/stable-diffusion-v1-5
MODEL_CACHE_DIR=/app/models
HF_HOME=/app/models
LOCAL_FILES_ONLY=true

# Inference defaults (form fields can override per request)
DEFAULT_STRENGTH=0.2
DEFAULT_GUIDANCE_SCALE=5.0
DEFAULT_NUM_INFERENCE_STEPS=25

# Limits
MAX_UPLOAD_BYTES=10485760
MAX_INFERENCE_DIMENSION=1024
MAX_CONCURRENT_INFERENCE=1
INFERENCE_TIMEOUT_SECONDS=120

# GPU
DEVICE=cuda
DTYPE=float16
ENABLE_XFORMERS=true

# Runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# R2 cloudflare cloud
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Redis
REDIS_URL=

# CORS
CORS_ALLOWED_ORIGINS=
