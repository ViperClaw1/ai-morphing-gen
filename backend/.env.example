ENV=development
LOG_LEVEL=INFO

# Data layer — SQLite for MVP; becomes POSTGRES_URL in Phase 2 (see docs/implementation_plan.md §2.1)
SQLITE_PATH=./data/app.db

# RQ (Redis Queue) — NOT Celery, see CLAUDE.md architecture rules
REDIS_URL=redis://localhost:6379/0

# GPU worker (RunPod serverless) — set once the endpoint is provisioned, §1.2
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Object storage — Cloudflare R2 (S3-compatible)
STORAGE_PATH=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

PREVIEW_ENABLED=true
PREVIEW_TTL_HOURS=3
PREVIEW_LIMIT_PER_PROJECT=3

CORS_ALLOWED_ORIGINS=http://localhost:3000
